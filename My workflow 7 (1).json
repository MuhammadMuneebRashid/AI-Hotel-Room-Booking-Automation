    {
      "parameters": {
        "jsCode": "const bookings = $input.all();\n\nconst requestedRoom = $('Edit Fields').first().json['Room Type'];\nconst requestedCheckIn = new Date(\n  $('Edit Fields').first().json['Check-in']\n);\nconst requestedCheckOut = new Date(\n  $('Edit Fields').first().json['Check-out']\n);\n\nlet available = true;\n\nfor (const booking of bookings) {\n\n  if (booking.json['Room Type'] !== requestedRoom) {\n    continue;\n  }\n\n  const existingCheckIn = new Date(booking.json['Check-in']);\n  const existingCheckOut = new Date(booking.json['Check-out']);\n\n  if (\n    requestedCheckIn < existingCheckOut &&\n    requestedCheckOut > existingCheckIn\n  ) {\n    available = false;\n    break;\n  }\n}\n\nreturn [\n  {\n    json: {\n      available\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",

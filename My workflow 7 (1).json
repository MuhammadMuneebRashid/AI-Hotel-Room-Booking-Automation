    {
      "parameters": {
        "jsCode": "const bookings = $input.all();\nconst request = $('Edit Fields').first().json;\n\nfunction parseDate(value) {\n  if (!value) return null;\n\n  const [day, month, year] = String(value)\n    .trim()\n    .split(\"-\")\n    .map(Number);\n\n  return new Date(year, month - 1, day);\n}\n\nconst requestedRoom = String(request.room_type || \"\")\n  .trim()\n  .toLowerCase();\n\nconst requestedCheckIn = parseDate(request.check_in_date);\nconst requestedCheckOut = parseDate(request.check_out_date);\n\nconst conflict = bookings.some(item => {\n  const booking = item.json;\n\n  // Availability-result rows ko ignore karo\n  const status = String(booking.Status || \"\")\n    .trim()\n    .toLowerCase();\n\n  if (status === \"room is available\") {\n    return false;\n  }\n\n  const existingRoom = String(booking.room_type || \"\")\n    .trim()\n    .toLowerCase();\n\n  if (existingRoom !== requestedRoom) {\n    return false;\n  }\n\n  const existingCheckIn = parseDate(booking.check_in_date);\n  const existingCheckOut = parseDate(booking.check_out_date);\n\n  if (!existingCheckIn || !existingCheckOut) {\n    return false;\n  }\n\n  return (\n    existingCheckIn < requestedCheckOut &&\n    existingCheckOut > requestedCheckIn\n  );\n});\n\nreturn [\n  {\n    json: {\n      ...request,\n      isAvailable: !conflict,\n      message: conflict\n        ? \"Room is not available\"\n        : \"Room is available\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

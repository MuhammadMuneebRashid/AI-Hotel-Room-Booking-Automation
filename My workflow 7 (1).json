    {
      "parameters": {
        "jsCode": "const field=$input.first().json.body.data.fields;\nconst field_1=field.find(f=>f.label===\"Full Name:\");\nconst name=field_1.value;\nconst field_2=field.find(f=>f.label===\"Email:\");\nconst email=field_2.value;\nconst field_3=field.find(f=>f.label===\"Phone:\");\nconst phone=field_3.value;\nconst field_4=field.find(f=>f.label===\"Check-in Date:\");\nconst check_in_date=field_4.value;\nconst field_5=field.find(f=>f.label===\"Check-out Date:\");\nconst check_out_date=field_5.value;\nconst field_6=field.find(f=>f.label===\"Room-type:\");\nconst value=field_6.value[0];\nconst option=field_6.options.find(o=>o.id===value);\nconst room_type=option.text;\nconst field_7=field.find(f=>f.label===\"Number of Guest:\")\nconst number_of_guest=field_7.value;\nconst field_8=field.find(f=>f.label===\"Special Request:\")\nconst special_request=field_8.value;\nreturn[{\n  name,\n  email,\n  phone,\n  check_in_date,\n  check_out_date,\n  room_type,\n  number_of_guest,\n  special_request\n}];"
      },
